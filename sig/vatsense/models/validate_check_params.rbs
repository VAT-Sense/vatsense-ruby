module Vatsense
  module Models
    type validate_check_params =
      { eori_number: String, requester_vat_number: String, vat_number: String, match_address: String, match_city: String, match_company_name: String, match_postcode: String, match_street: String }
      & Vatsense::Internal::Type::request_parameters

    class ValidateCheckParams < Vatsense::Internal::Type::BaseModel
      extend Vatsense::Internal::Type::RequestParameters::Converter
      include Vatsense::Internal::Type::RequestParameters

      attr_reader eori_number: String?

      def eori_number=: (String) -> String

      attr_reader match_address: String?

      def match_address=: (String) -> String

      attr_reader match_city: String?

      def match_city=: (String) -> String

      attr_reader match_company_name: String?

      def match_company_name=: (String) -> String

      attr_reader match_postcode: String?

      def match_postcode=: (String) -> String

      attr_reader match_street: String?

      def match_street=: (String) -> String

      attr_reader requester_vat_number: String?

      def requester_vat_number=: (String) -> String

      attr_reader vat_number: String?

      def vat_number=: (String) -> String

      def initialize: (
        ?eori_number: String,
        ?match_address: String,
        ?match_city: String,
        ?match_company_name: String,
        ?match_postcode: String,
        ?match_street: String,
        ?requester_vat_number: String,
        ?vat_number: String,
        ?request_options: Vatsense::request_opts
      ) -> void

      def to_hash: -> {
        eori_number: String,
        match_address: String,
        match_city: String,
        match_company_name: String,
        match_postcode: String,
        match_street: String,
        requester_vat_number: String,
        vat_number: String,
        request_options: Vatsense::RequestOptions
      }
    end
  end
end
